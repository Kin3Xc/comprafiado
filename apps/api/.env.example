# Servidor
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
# URL pública de esta API — ePayco envía el webhook aquí (en local usar túnel: ngrok/cloudflared)
API_PUBLIC_URL=http://localhost:4000

# MongoDB Atlas — crear cluster en https://cloud.mongodb.com y pegar el connection string
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/comprafiado?retryWrites=true&w=majority

# JWT — generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ePayco (fase 3) — https://dashboard.epayco.co
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_P_CUST_ID=
EPAYCO_P_KEY=
EPAYCO_TEST_MODE=true

# WhatsApp Cloud API (fase 5)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Resend — sin key, los correos solo se registran en el log (modo dev)
RESEND_API_KEY=
EMAIL_FROM=CompraFiado <onboarding@resend.dev>

# Cloudinary (fase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
